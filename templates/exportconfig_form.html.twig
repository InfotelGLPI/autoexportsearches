{# Export configuration form (Exportconfig::showForm()). The core generic form provides the
   card, the header and the action buttons; the saved search, profile, custom criteria and
   periodicity value parts are loaded through ajax/ into the containers below. #}
{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
    {{ fields.dropdownYesNo('is_active', item.fields['is_active'], __('Active')) }}

    {{ fields.largeTitle(__('Search to export', 'autoexportsearches'), 'ti ti-search') }}

    {{ fields.htmlField('users_id', user_dropdown ~ user_events, __('User who owns the saved search', 'autoexportsearches'), {
        'wrapper_class': '',
    }) }}
    {{ fields.htmlField('', '<div id="savedProfile"></div>', __('Used profile', 'autoexportsearches'), {
        'wrapper_class': '',
    }) }}
    {{ fields.htmlField('', '<div id="savedSearches"></div>', __('Saved search to export', 'autoexportsearches'), {
        'wrapper_class': '',
    }) }}

    <div class="col-12 mb-2" id="custom_search_criterias"></div>

    {{ fields.largeTitle(__('Periodicity'), 'ti ti-calendar-repeat') }}

    {{ fields.dropdownArrayField('periodicity_type', item.fields['periodicity_type'], periodicity_types, __('Periodicity type', 'autoexportsearches'), {
        'rand': rand_period,
    }) }}
    <div class="col-12 col-sm-6 mb-2" id="periodicity_value"></div>

    {{ fields.largeTitle(__('Options', 'autoexportsearches'), 'ti ti-mail') }}

    {{ fields.emailField('sendto', item.fields['sendto'], __('Send mail to', 'autoexportsearches')) }}

    <script>
    $(function () {
        $('#dropdown_users_id{{ rand }}').trigger('change');

        const periodicity_type = $('#dropdown_periodicity_type{{ rand_period }}');
        periodicity_type.on('change', function () {
            $('#periodicity_value').load('{{ periodicity_url|e('js') }}', {
                'id': {{ item.getID() > 0 ? item.getID() : 0 }},
                'periodicity_type': $(this).val()
            });
        }).trigger('change');
    });
    </script>
{% endblock %}
