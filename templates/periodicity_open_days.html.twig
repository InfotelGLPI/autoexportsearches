<div id="periodicity_open_days" class="mt-2">
    <label class="form-check form-switch mb-0">
        <input name="periodicity_open_days" type="checkbox" class="form-check-input" value="1"
               {{ open_days_checked ? 'checked' : '' }}>
        <span class="form-check-label">
            {{ open_days_label }}
            <span class="form-help" tabindex="0" aria-label="{{ open_days_explanation }}"
                  data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="{{ open_days_explanation }}">?</span>
        </span>
    </label>
</div>
