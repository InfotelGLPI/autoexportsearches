<div class="center">
   <table class="tab_cadre" width="30%" cellpadding="5">
      <tr>
         <th colspan="6">{{ title }}</th>
      </tr>
      <tr>
         {% for item in items %}
            <td class="center" colspan="3">
               <a href="{{ item.url }}">
                  <i class="{{ item.icon }}"></i>
                  <br>{{ item.label }}
               </a>
            </td>
         {% endfor %}
      </tr>
   </table>
</div>
