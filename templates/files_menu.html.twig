{# Export folders of the browsed owner (Files::showMenu()): one clickable card per folder #}
<div class="container-lg my-3">
    <h2 class="mb-3">
        <i class="ti ti-folders me-2"></i>{{ type_name }}
    </h2>
    {% if types is empty %}
        <div class="alert alert-info">
            <i class="ti ti-info-circle me-2"></i>{{ __('No export files available', 'autoexportsearches') }}
        </div>
    {% else %}
        <div class="row row-cards g-3">
            {% for type in types %}
                <div class="col-12 col-sm-6 col-lg-4">
                    <a href="{{ base_url }}?type={{ type|url_encode }}&users_id={{ owner_id }}"
                       class="card card-link card-link-pop h-100 text-reset text-decoration-none">
                        <div class="card-body d-flex align-items-center gap-3">
                            <span class="avatar avatar-md bg-yellow-lt flex-shrink-0">
                                <i class="ti ti-folder-open fs-2"></i>
                            </span>
                            <div class="fw-bold text-truncate" title="{{ type }}">{{ type }}</div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
