{# Plugin setup (Config::showConfigForm()) #}
{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="container-lg my-3">
    <form name="form" method="post" action="{{ item_form_url }}" class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="ti ti-settings me-2"></i>{{ __('Setup') }}
            </h3>
        </div>
        <div class="card-body">
            <div class="hr-text mt-0">
                <i class="ti ti-trash-x"></i>
                <span>{{ __('Files', 'autoexportsearches') }}</span>
            </div>
            <div class="row">
                {{ fields.numberField('monthBeforePurge', month_before_purge, __('Number of months before purge files', 'autoexportsearches'), {
                    'min': 0,
                    'full_width': true,
                    'label_class': 'col-md-4',
                    'input_class': 'col-md-3',
                }) }}
            </div>
        </div>
        <div class="card-footer text-end">
            <button type="submit" name="update" value="1" class="btn btn-primary">
                <i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Save') }}
            </button>
        </div>
    </form>
</div>
