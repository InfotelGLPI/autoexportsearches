{# Plugin rights of a profile (Profile::showForm()): the core rights matrix, then the two
   boolean rights as switches. A hidden 0 precedes each switch so that unchecking it actually
   revokes the right (Profile::prepareInputForUpdate() only updates the posted "_<right>"). #}
<div class="firstbloc">
    {% if canedit %}
        <form method="post" action="{{ profile_form_url }}">
    {% endif %}

    {{ rights_matrix|raw }}

    <div class="card mt-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-check form-switch mb-0">
                        <input type="hidden" name="_plugin_autoexportsearches_accessfiles" value="0">
                        <input type="checkbox" class="form-check-input" name="_plugin_autoexportsearches_accessfiles"
                               value="1"{% if access_files_checked %} checked{% endif %}{% if not canedit %} disabled{% endif %}>
                        <span class="form-check-label">
                            <i class="ti ti-download me-1"></i>{{ __('Access to download files', 'autoexportsearches') }}
                        </span>
                    </label>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-check form-switch mb-0">
                        <input type="hidden" name="_plugin_autoexportsearches_configs" value="0">
                        <input type="checkbox" class="form-check-input" name="_plugin_autoexportsearches_configs"
                               value="1"{% if configs_checked %} checked{% endif %}{% if not canedit %} disabled{% endif %}>
                        <span class="form-check-label">
                            <i class="ti ti-settings me-1"></i>{{ __('Configuration') }}
                        </span>
                    </label>
                </div>
            </div>
        </div>
        {% if canedit %}
            <div class="card-footer text-center">
                <input type="hidden" name="id" value="{{ profiles_id }}">
                <button type="submit" name="update" value="1" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Save') }}
                </button>
            </div>
        {% endif %}
    </div>

    {% if canedit %}
        </form>
    {% endif %}
</div>
