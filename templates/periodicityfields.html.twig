{% if periodicity_type == PERIODICITY_MINUTES %}
   <td>{{ __('Periodicity (in minutes)', 'autoexportsearches') }}</td>
   <td><div>{{ dropdown|raw }}</div></td>
{% elseif periodicity_type == PERIODICITY_HOURS %}
   <td>{{ __('Periodicity (in hours)', 'autoexportsearches') }}</td>
   <td><div>{{ dropdown|raw }}</div></td>
{% elseif periodicity_type == PERIODICITY_DAYS %}
   <td>{{ __('Periodicity (in days)', 'autoexportsearches') }}</td>
   <td>
      <div>{{ dropdown|raw }}</div>
      {{ include('@autoexportsearches/periodicity_open_days.html.twig') }}
   </td>
{% elseif periodicity_type == PERIODICITY_WEEKLY %}
   <td>{{ __('Weekday', 'autoexportsearches') }}</td>
   <td>{{ dropdown|raw }}</td>
{% elseif periodicity_type == PERIODICITY_MONTHLY %}
   <td>{{ __('Day of the month', 'autoexportsearches') }}</td>
   <td>
      <div>
         {{ dropdown|raw }}
         <small class="ms-2">{{ monthly_note }}</small>
      </div>
      {{ include('@autoexportsearches/periodicity_open_days.html.twig') }}
   </td>
{% endif %}
