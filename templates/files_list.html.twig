{# Export files of one folder (Files::showListFiles()). Deleting goes through a single form;
   the "check all" box only toggles the checkboxes of this table. #}
<div class="container-lg my-3">
    <div class="card">
        <div class="card-header d-flex align-items-center">
            <h3 class="card-title">
                <i class="ti ti-files me-2"></i>{{ __('Files', 'autoexportsearches') }}
                <span class="text-secondary fw-normal ms-1">· {{ type }}</span>
            </h3>
            {% if visible_files is not empty %}
                <span class="badge bg-secondary-lt ms-2">{{ files|length }}</span>
            {% endif %}
            <a href="{{ base_url }}?users_id={{ owner_id }}" class="btn btn-sm btn-outline-secondary ms-auto">
                <i class="ti ti-arrow-left me-1"></i>{{ __('Back') }}
            </a>
        </div>

        {% if not dir_exists %}
            <div class="card-body">
                <div class="alert alert-warning mb-0">
                    <i class="ti ti-alert-triangle me-2"></i>{{ __("The folder doesn't exist", 'autoexportsearches') }}
                </div>
            </div>
        {% elseif files is empty %}
            <div class="card-body">
                <div class="alert alert-info mb-0">
                    <i class="ti ti-info-circle me-2"></i>{{ __('No file to download in the directory', 'autoexportsearches') }}
                </div>
            </div>
        {% else %}
            <form name="deleteCSV" method="post" action="{{ form_action }}">
                <div class="card-body pb-0">
                    {{ pager|raw }}
                </div>
                <div class="table-responsive">
                    <table id="tableCsv" class="table table-hover table-vcenter card-table">
                        <thead>
                            <tr>
                                <th class="w-1">
                                    <input type="checkbox" class="form-check-input" id="checkall_delete"
                                           title="{{ __('Check all') }}" aria-label="{{ __('Check all') }}"
                                           onclick="document.querySelectorAll('#tableCsv tbody input[type=checkbox]').forEach(cb => cb.checked = this.checked);">
                                </th>
                                <th>
                                    <a href="{{ base_url }}?type={{ type|url_encode }}&users_id={{ owner_id }}&orderCol=name&orderType={{ order_toggle }}&start={{ start }}"
                                       class="text-reset">
                                        {{ __('File name', 'autoexportsearches') }}<i class="ti ti-arrows-sort ms-1 text-secondary"></i>
                                    </a>
                                </th>
                                <th>
                                    <a href="{{ base_url }}?type={{ type|url_encode }}&users_id={{ owner_id }}&orderCol=date&orderType={{ order_toggle }}&start={{ start }}"
                                       class="text-reset">
                                        {{ __('Generation date', 'autoexportsearches') }}<i class="ti ti-arrows-sort ms-1 text-secondary"></i>
                                    </a>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for file in visible_files %}
                                <tr>
                                    <td class="w-1">
                                        <input type="checkbox" class="form-check-input" name="filedelete[{{ file.name }}]" value="1"
                                               aria-label="{{ file.name }}">
                                    </td>
                                    <td>
                                        <i class="ti ti-file-spreadsheet text-secondary me-1"></i>
                                        {% if can_download %}
                                            <a href="{{ plugin_dir }}/front/document.send.php?file={{ file.name|url_encode }}&users_id={{ owner_id }}" target="_blank">
                                                {{ file.name }}
                                            </a>
                                        {% else %}
                                            {{ file.name }}
                                        {% endif %}
                                    </td>
                                    <td class="text-secondary">{{ file.date_formatted }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-end">
                    {# Carry the browsed owner sub-directory so the delete stays scoped to it. #}
                    <input type="hidden" name="filedelete_users_id" value="{{ owner_id }}">
                    <button type="submit" class="btn btn-outline-danger"
                            onclick="return confirm('{{ __('Confirm the final deletion?')|e('js') }}')">
                        <i class="ti ti-trash me-1"></i>{{ __('Delete') }}
                    </button>
                </div>
            </form>
        {% endif %}
    </div>
</div>
